{
  "rule": "rules/windows/lsass_credential_access.yml",
  "cases": [
    {
      "name": "rundll32 comsvcs minidump of LSASS",
      "expect": true,
      "event": {
        "SourceImage": "C:\\Windows\\System32\\rundll32.exe",
        "TargetImage": "C:\\Windows\\System32\\lsass.exe",
        "GrantedAccess": "0x1410",
        "CallTrace": "C:\\Windows\\System32\\comsvcs.dll+1f0a3"
      }
    },
    {
      "name": "full access handle to LSASS",
      "expect": true,
      "event": {
        "SourceImage": "C:\\Users\\Public\\dump.exe",
        "TargetImage": "C:\\Windows\\System32\\lsass.exe",
        "GrantedAccess": "0x1fffff",
        "CallTrace": "UNKNOWN"
      }
    },
    {
      "name": "low-privilege query handle only",
      "expect": false,
      "event": {
        "SourceImage": "C:\\Windows\\System32\\taskmgr.exe",
        "TargetImage": "C:\\Windows\\System32\\lsass.exe",
        "GrantedAccess": "0x1000",
        "CallTrace": "C:\\Windows\\System32\\ntdll.dll+9d2e4"
      }
    },
    {
      "name": "Defender engine is excluded by filter",
      "expect": false,
      "event": {
        "SourceImage": "C:\\ProgramData\\Microsoft\\Windows Defender\\Platform\\4.18\\MsMpEng.exe",
        "TargetImage": "C:\\Windows\\System32\\lsass.exe",
        "GrantedAccess": "0x1410",
        "CallTrace": "C:\\Windows\\System32\\ntdll.dll+9d2e4"
      }
    },
    {
      "name": "handle to a different process",
      "expect": false,
      "event": {
        "SourceImage": "C:\\Windows\\System32\\rundll32.exe",
        "TargetImage": "C:\\Windows\\System32\\winlogon.exe",
        "GrantedAccess": "0x1410",
        "CallTrace": "UNKNOWN"
      }
    }
  ]
}
